<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Meal Management</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Login screen (filled in by auth.js) -->
  <div id="login"></div>

  <!-- Main screen after login (hidden until someone logs in) -->
  <div id="shell" hidden>
    <header>
      <h1 id="title"></h1>
      <span id="who" class="muted"></span>
      <button id="logoutButton">Logout</button>
    </header>
    <nav id="nav"></nav>      <!-- menu buttons -->
    <main id="app"></main>    <!-- the current page -->
  </div>

  <!-- Small popup message at the bottom -->
  <div id="msg"></div>

  <!-- Order matters: data first, main last -->
  <script src="data.js"></script>
  <script src="auth.js"></script>
  <script src="admin.js"></script>
  <script src="user.js"></script>
  <script src="main.js"></script>
</body>
</html>


