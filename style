/* ---------- Colors (light mode, then dark mode) ---------- */
:root {
  --bg: #f5f6fa;
  --card: #ffffff;
  --text: #1f2430;
  --muted: #6b7280;
  --main: #e8590c;       /* orange buttons */
  --on-main: #ffffff;    /* text on orange */
  --border: #e3e5ea;
  --good: #2f9e44;       /* green */
  --bad: #e03131;        /* red */
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #14161b;
    --card: #1e2128;
    --text: #eceef2;
    --muted: #9aa1ae;
    --main: #ff8a3d;
    --on-main: #1a1a1a;
    --border: #2d313a;
  }
}
 
/* ---------- Page basics ---------- */
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
}
h2 { margin: 6px 0 12px; font-size: 20px; }
main { max-width: 1000px; margin: auto; padding: 10px 20px 40px; }
 
/* ---------- Top bar and menu ---------- */
header {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 12px 20px;
  background: var(--card);
  border-bottom: 1px solid var(--border);
}
header h1 { flex: 1; margin: 0; font-size: 18px; }
nav { display: flex; gap: 6px; flex-wrap: wrap; padding: 10px 20px; }
 
/* ---------- Buttons and inputs ---------- */
button {
  font: inherit;
  cursor: pointer;
  padding: 7px 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--card);
  color: var(--text);
}
button:hover { border-color: var(--main); }
button.active, button.primary {      /* selected tab / main action */
  background: var(--main);
  color: var(--on-main);
  border-color: var(--main);
}
button.danger { color: var(--bad); }
 
input, select {
  font: inherit;
  max-width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  color: var(--text);
}
input[type=checkbox] { width: 18px; height: 18px; vertical-align: middle; }
 
/* ---------- Cards, grids, rows ---------- */
.card {
  margin-bottom: 14px;
  padding: 16px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
.stat b { display: block; font-size: 26px; color: var(--main); }
.row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
 
/* ---------- Tables ---------- */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { padding: 8px; text-align: left; vertical-align: middle; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; }
.no-wrap th, .no-wrap td { white-space: nowrap; }
 
/* ---------- Small helpers ---------- */
.muted { color: var(--muted); font-size: 13px; }
.good { color: var(--good); }
.bad { color: var(--bad); }
.badge { padding: 2px 9px; font-size: 12px; border: 1px solid currentColor; border-radius: 99px; }
 
/* ---------- Login box and popup message ---------- */
#login { max-width: 400px; margin: 8vh auto; padding: 0 16px; }
.tabs { display: flex; gap: 6px; margin-bottom: 12px; }
.tabs button { flex: 1; }
#msg {
  display: none;
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 10px 18px;
  background: var(--text);
  color: var(--bg);
  border-radius: 99px;
  z-index: 9;
}
 
